{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {"type": "string", "enum": ["planned", "stop", "needs_owner_input"]},
    "summary": {"type": "string"},
    "owner_question": {"type": "string"},
    "objective": {"type": "string"},
    "factors": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "description": {"type": "string"},
          "level0": {"type": "string"},
          "level1": {"type": "string"}
        },
        "required": ["id", "name", "description", "level0", "level1"]
      }
    },
    "probes": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "text": {"type": "string"},
          "provenance": {"type": "string"},
          "controlled_variable": {"type": "string"},
          "semantic_fidelity_note": {"type": "string"},
          "synthetic": {"type": "boolean"},
          "assignments": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "factor_id": {"type": "string"},
                "level": {"type": "integer", "enum": [0, 1]}
              },
              "required": ["factor_id", "level"]
            }
          }
        },
        "required": ["id", "text", "provenance", "controlled_variable", "semantic_fidelity_note", "synthetic", "assignments"]
      }
    },
    "contrasts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "label": {"type": "string"},
          "left_probe": {"type": "string"},
          "right_probe": {"type": "string"},
          "interpretive_question": {"type": "string"},
          "repeat_eligible": {"type": "boolean"}
        },
        "required": ["id", "label", "left_probe", "right_probe", "interpretive_question", "repeat_eligible"]
      }
    },
    "repeat_threshold": {"type": "number", "minimum": 0, "maximum": 1},
    "blind_editorial_judgments": {"type": "array", "items": {"type": "string"}},
    "stop_rule": {"type": "string"},
    "why_high_information": {"type": "string"}
  },
  "required": ["status", "summary", "owner_question", "objective", "factors", "probes", "contrasts", "repeat_threshold", "blind_editorial_judgments", "stop_rule", "why_high_information"]
}
