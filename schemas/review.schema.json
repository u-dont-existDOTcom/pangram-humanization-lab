{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {"type": "string", "enum": ["approved", "needs_owner_input"]},
    "approved_probe_ids": {"type": "array", "items": {"type": "string"}},
    "rejected": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {"probe_id": {"type": "string"}, "reason": {"type": "string"}},
        "required": ["probe_id", "reason"]
      }
    },
    "notes": {"type": "array", "items": {"type": "string"}},
    "owner_question": {"type": "string"}
  },
  "required": ["status", "approved_probe_ids", "rejected", "notes", "owner_question"]
}
